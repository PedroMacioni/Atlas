# Atlas API — copie para `.env` e preencha. O `.env` nunca é versionado.

ATLAS_ENVIRONMENT=development

# --- Supabase --------------------------------------------------------------
ATLAS_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave `service_role`, em Project Settings → API Keys → service_role (secret).
# Ela ignora RLS de propósito: é ela que lê e escreve `route_cache`, que não
# tem policy nenhuma. NUNCA coloque esta chave no aplicativo — é justamente
# para mantê-la fora do binário que esta API existe.
#
# Com a chave `anon` no lugar dela, o catálogo de lugares funciona (tem policy
# de leitura pública) mas o cache de rotas fica inerte: a API avisa no log e
# consulta o provider externo em toda chamada.
ATLAS_SUPABASE_SERVICE_KEY=

# --- Rotas -----------------------------------------------------------------
ATLAS_ROUTE_PROVIDER=osrm

# Servidor de demonstração do OSRM: sem SLA, sem uso comercial, sem chave.
# Aponte para uma instância própria antes de qualquer distribuição.
ATLAS_OSRM_BASE_URL=https://router.project-osrm.org

# Validade de uma rota no cache, em segundos. `0` desliga o cache.
ATLAS_ROUTE_CACHE_TTL_SECONDS=3600

# Tempo limite de qualquer chamada de saída, espelhando os 12 s de utils/http.ts.
ATLAS_OUTBOUND_TIMEOUT_SECONDS=12

# --- Lugares próximos (Google Places) --------------------------------------
# Chave da "Places API (New)". Vazia, a API usa só o OpenStreetMap — funciona,
# mas sem nota e bem mais devagar. Passo a passo em backend/README.md,
# "Configurar o Google Places". Nunca coloque esta chave no aplicativo.
ATLAS_GOOGLE_PLACES_API_KEY=

# Consultas ao Google por dia, contadas por esta API. O plano com nota tem
# 1.000 grátis por mês (~33/dia); 30 deixa folga. A cota do console do Google
# é a segunda barreira, e vale mesmo com a API reiniciada.
ATLAS_GOOGLE_PLACES_DAILY_LIMIT=30

# --- Rede ------------------------------------------------------------------
# Em desenvolvimento o Expo Go roda em outro aparelho da rede local.
ATLAS_CORS_ALLOW_ORIGINS=["*"]
