# Atlas — configuração do aplicativo. Copie para `.env`.
#
# Só a URL da API e flags entram aqui. Variáveis `EXPO_PUBLIC_` são inlinadas no bundle
# e ficam visíveis em texto puro no aplicativo compilado — nenhuma chave de API
# pode passar por este arquivo. É para isso que existe o backend em `backend/`.
#
# Sem esta variável, o aplicativo funciona como na fase anterior: rotas direto
# do OSRM público e lugares da lista local.
#
# No Expo Go o aplicativo roda em outro aparelho, então `localhost` não resolve:
# use o IP da máquina na rede local.
EXPO_PUBLIC_ATLAS_API_URL=http://192.168.0.10:8787

# Ferramentas de desenvolvimento (hoje, o botão do modo apresentação na home).
# Desligada quando ausente; `true` ou `1` liga.
EXPO_PUBLIC_DEV_MODE=false
